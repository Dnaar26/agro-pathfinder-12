# Supabase local (Docker)
# Obtén tus keys locales con: supabase start
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="<your-local-publishable-key>"
# ⚠️ Solo server-side. NUNCA usar VITE_ prefix para service_role key
SUPABASE_SERVICE_ROLE_KEY="<your-local-service-role-key>"
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-local-publishable-key>"

# Groq — para asistente IA (server-side, nunca llega al cliente)
# Consigue una key gratis en https://console.groq.com
GROQ_API_KEY="<your-groq-api-key>"

# Solo desarrollo local; nunca configurar en producción.
SEED_TEST_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# Origenes permitidos para server functions sensibles, separados por coma.
# En produccion, reemplazar por el dominio publico real del sitio web transnacional.
APP_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Produccion: Render asigna PORT automaticamente; no lo fijes en el panel.
NODE_ENV="development"
PORT="3000"

# Sentinel Hub (opcional: visor NDVI, solo servidor)
SENTINEL_INSTANCE_ID=""
SENTINEL_API_KEY=""

# Notificaciones push (opcional)
VITE_VAPID_PUBLIC_KEY=""

# Google OAuth (opcional en local)
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Añadir http://localhost:54321/auth/v1/callback como URI de redireccionamiento
GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""
