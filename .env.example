# Supabase local (Docker) o Cloud
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="<your-local-publishable-key>"
# ⚠️ Solo server-side. NUNCA usar VITE_ prefix para service_role key
SUPABASE_SERVICE_ROLE_KEY="<your-local-service-role-key>"
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-local-publishable-key>"

# ========================================================================
# ASISTENTE AGRONÓMICO IA — CASCADA 100% GRATUITA (SIN TARJETA DE CRÉDITO)
# ========================================================================
# 1. Primario gratis: GroqCloud Free Plan (https://console.groq.com)
#    Usa automáticamente en cascada: openai/gpt-oss-120b -> openai/gpt-oss-20b -> qwen/qwen3.8-27b
#    + whisper-large-v3-turbo para dictado de voz en campo.
GROQ_API_KEY="<your-free-groq-api-key>"
# Dejar vacío para usar la rotación automática gratuita (NO usar llama-3.3-70b-versatile, retirado en plan gratis)
GROQ_MODEL=""

# 2. Respaldo gratis #1: Google AI Studio Free Tier (https://aistudio.google.com/app/apikey)
#    Usa automáticamente gemini-3.5-flash-lite y gemini-3.8-flash (texto y diagnóstico de fotos de hojas)
GEMINI_API_KEY=""

# 3. Respaldo gratis #2 (opcional): OpenRouter Free Router (https://openrouter.ai/keys)
#    Usa automáticamente openrouter/free ($0/M tokens sin tarjeta)
OPENROUTER_API_KEY=""

# Solo desarrollo local; nunca configurar en producción.
SEED_TEST_PASSWORD=""
SEED_ADMIN_PASSWORD=""
ENABLE_SEED_TOOLS="false"

# Orígenes permitidos para server functions sensibles, separados por coma.
APP_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"

NODE_ENV="development"
PORT="3000"

# Sentinel Hub (opcional: visor NDVI, solo servidor)
SENTINEL_INSTANCE_ID=""
SENTINEL_API_KEY=""

# Notificaciones push (opcional)
VITE_VAPID_PUBLIC_KEY=""

# Integración SIPSA/DANE (opcional)
VITE_MARKET_PRICES_URL=""

# Telemetría de usabilidad Microsoft Clarity (gratis en https://clarity.microsoft.com)
VITE_CLARITY_PROJECT_ID=""

# Webhook opcional para alertas externas de errores de cliente
VITE_ERROR_WEBHOOK_URL=""

# Google OAuth (opcional en local)
GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""
